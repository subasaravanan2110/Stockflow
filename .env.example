# PostgreSQL (Prisma Postgres, Neon, or any PostgreSQL 15+ database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# GitHub OAuth App callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Leave empty for assessment demos. In production, add exact company domains such as stockflow.com.
GITHUB_ALLOWED_EMAIL_DOMAINS=""

# Assessment demo: each user receives one short first session, then normal 7-day sessions.
DEMO_SHORT_SESSION_SECONDS="60"

# Option A for assessment demos: Gmail SMTP. Requires 2-Step Verification and an App Password.
# When both Gmail values are set, Gmail takes precedence over Resend.
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""

# Option B for production: Resend with a verified sending domain.
RESEND_API_KEY=""
EMAIL_FROM="StockFlow <onboarding@example.com>"

# Optional inventory assistant. Without both values, deterministic answers are used.
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Candidate links shown in the footer
NEXT_PUBLIC_CANDIDATE_NAME="Your Name"
NEXT_PUBLIC_GITHUB_URL="https://github.com/your-username"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/your-profile"

# Optional bootstrap admin used by the seed command
SEED_ADMIN_EMAIL="admin@stockflow.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
